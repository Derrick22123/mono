# Agent Chat App — environment variables

# Required: model API key (DeepSeek / OpenAI-compatible providers)
# Accepts OPENAI_API_KEY or DEEPSEEK_API_KEY
OPENAI_API_KEY=sk-your-deepseek-key-here

# Optional: OpenAI-compatible API base URL (default: DeepSeek)
OPENAI_BASE_URL=https://api.deepseek.com

# Optional Anthropic-compatible base (informational; v1 chat uses OPENAI_BASE_URL)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Optional: model id (default: deepseek-v4-flash)
# Alternatives: deepseek-v4-pro
OPENAI_MODEL=deepseek-v4-flash

# Optional: AgentOS listen port (default: 7777)
AGENT_OS_PORT=7777

# Required for web dev/build: backend base URL (apps/web)
VITE_API_BASE_URL=http://localhost:7777

# Optional: comma-separated CORS origins for Vite dev
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
