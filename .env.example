# Agent Chat App — environment variables

# Required: OpenAI API key for real model responses (apps/api)
OPENAI_API_KEY=sk-your-key-here

# Optional: OpenAI model id (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: AgentOS listen port (default: 7777)
AGENT_OS_PORT=7777

# Required for web dev/build: backend base URL (apps/web)
VITE_API_BASE_URL=http://localhost:7777

# Optional: comma-separated CORS origins for Vite dev
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
